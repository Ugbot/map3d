{
    "id": "city",
    "type": "application",
    "value": {
        "use": [
            "flecs",
            "flecs.components.transform",
            "flecs.components.graphics",
            "flecs.components.geometry",
            "flecs.components.physics",
            "flecs.components.gui",
            "flecs.systems.physics",
            "flecs.systems.transform",
            "flecs.systems.sokol",
            "flecs.game"
        ],
        "standalone": true
    },
    "lang.c": {
        "${target em}": {
            "cflags": ["-DBEAM_DRIVEN=1"],
            "ldflags": [
                "-sSTACK_SIZE=1000000",
                "-Wl,-u,ntohs",
                "-sALLOW_MEMORY_GROWTH=1",
                "-sEXPORTED_FUNCTIONS=['_main','_beam_init','_beam_begin_frame','_beam_end_frame','_beam_agent_upsert','_beam_agent_remove','_beam_agent_remove_kind','_beam_feed_upsert','_beam_feed_remove','_beam_feed_remove_kind','_beam_set_env','_beam_clear_all','_beam_live_count','_beam_tile_begin','_beam_tile_end','_beam_tile_release','_beam_building_upsert','_beam_mesh_upsert','_beam_mesh_remove','_beam_lantern_upsert','_beam_prop_upsert','_beam_set_camera','_beam_camera_rotate_delta','_beam_world_info','_malloc','_free']",
                "-sEXPORTED_RUNTIME_METHODS=['ccall','cwrap','HEAPU8','HEAPF32','HEAPU32']"
            ],
            "embed": ["etc/assets"]
        }
    }
}
